{
  "name": "dither-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Composable, dithered charts for shadcn/ui — area, line, bar, pie & radar on a tiny ordered-dither canvas engine.",
  "homepage": "https://tripwire.sh/dither-kit",
  "repository": {
    "type": "git",
    "url": "https://github.com/Boring-Software-Inc/dither-kit.git"
  },
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:registry && npm run build:cli",
    "build:cli": "npm run build -w @dither-kit/cli",
    "build:registry": "tsx scripts/build-registry.mts",
    "test": "vitest run && npm run test:cli",
    "test:cli": "node --import tsx --test packages/cli/test/*.test.ts"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "happy-dom": "^21.0.4",
    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^2.6.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "vite": "^6.4.5"
  }
}
